# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (older projects: "anon" key). Either variable name is accepted.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

RESEND_API_KEY=
# Verified sender address for Resend, e.g. bookings@youragency.com
EMAIL_FROM=

# Shared secret for the daily automation cron (min 16 chars). Vercel sends it as a Bearer token.
CRON_SECRET=

# Encrypts agencies' payment credentials stored in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored credentials unreadable (agencies would re-enter them). Never commit it.
ENCRYPTION_KEY=


# Backups (optional until you turn scheduled backups on). The key encrypts every backup file before it leaves the server:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store a COPY of this key somewhere other than the backup bucket: without it, backups cannot be opened.
BACKUP_ENCRYPTION_KEY=
# Destination: an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO...). All four are needed.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Development and tests only (ignored when APP_ENV=production): a folder on this machine
BACKUP_LOCAL_DIR=

# Platform Razorpay account (subscriptions to this product). Agencies enter their OWN keys inside the app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

UPSTASH_REDIS_REST_URL="
UPSTASH_REDIS_REST_TOKEN="

SENTRY_DSN=
# Optional label shown in error reports: development | preview | production
APP_ENV=

NEXT_PUBLIC_APP_URL=http://localhost:3000
