# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

RESEND_API_KEY=
# Verified sender address for Resend, e.g. bookings@youragency.com
EMAIL_FROM=

# Shared secret for the daily automation cron (min 16 chars). Vercel sends it as a Bearer token.
CRON_SECRET=


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SENTRY_DSN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
